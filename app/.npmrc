# Allow install scripts for the specific deps that need them.
# npm's new policy expects a comma-separated allow-list of package names
# (not a boolean), which is why the earlier `allow-scripts=true` had no
# effect and six packages were blocked.
#
# For this project, local ares scripts don't need to run — the global
# @webos-tools/cli handles everything the npm scripts call. We still allow
# them so a fresh `npm install` doesn't produce scary warnings.
ignore-scripts=false
allow-scripts=@webos-tools/cli,ssh2,cpu-features,fsevents,core-js,core-js-pure
# Keep audit noise from scaring new developers.
fund=false
